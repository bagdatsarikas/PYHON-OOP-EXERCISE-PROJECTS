Problem: Make an iterator class Countdown that gives 5, 4, 3, 2, 1.

class countdown:
    
    def __init__(self):
        self.num = 5 
        
    def __iter__(self):
        return self 
    
    def __next__(self):
        if self.num >= 1:
            value = self.num
            self.num = self.num - 1
            return value
        else : 
            raise StopIteration
            
for i in countdown():
    print(i)

### Write the same Countdown (5, 4, 3, 2, 1), but as a generator.

def countdown():
    n = 5 
    while n >= 1:
        yield n 
        n = n - 1
        
for i in countdown():
    print(i)
Your own iteratior : Write a class Squares that gives the squares of 1 to 5: 1, 4, 9, 16, 25.

​
class squares:
    
    def __init__(self):
        self.num = 1 
        
    def __iter__(self):
        return self 
    
    def __next__(self):
        
        if self.num <= 5:
            val = self.num * self.num 
            self.num = self.num + 1 
            return val
        
        else:
            raise StopIteration
            
for i in squares():
    print(i)

def squares():
    n = 1 
    while n <=5:
        yield n*n
        n = n + 1
for i in squares():
    print(i)

