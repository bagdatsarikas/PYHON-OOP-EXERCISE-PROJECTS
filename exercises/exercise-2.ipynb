Goal: use super().init() instead of copying lines.
Create a parent class vehicle:
init(self, br, sp) that saves self.brand and self.speed display(self) that prints Brand: , Speed:
Create a child class car(vehicle):
init(self, br, sp, dr) that uses super().init for brand and speed, then saves self.doors override display(self) so it calls the parent’s display with super(), then prints Doors:

class vehicle:                          # PARENT
    def __init__(self, br, sp):
        self.brand = br
        self.speed = sp
​
    def display(self):
        print("Brand:", self.brand, ", Speed:", self.speed)
​
​
class car(vehicle):                     
    def __init__(self, br, sp, dr):
        super().__init__(br, sp)        
        self.doors = dr                 
​
    def display(self):                  
        super().display()               # 1) run the parent's display first
        print("Doors:", self.doors)     # 2) then add the child's extra line
​
        

ob = car("toyota", 180, 5)
print(ob)
